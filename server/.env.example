# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173



# n8n orchestration (Express -> n8n webhook -> Gemini -> response)
N8N_TOPICS_WEBHOOK_URL=
N8N_CHAPTER_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_URL=
# shared secret sent via X-Faython-Secret header; must match the n8n workflow guard
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=90000
